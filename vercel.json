{
  "version": 2,
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/(.*\\.js)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*\\.mjs)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*\\.css)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*\\.mp3)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "audio/mpeg"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/guest",
      "destination": "/api/guest.js"
    },
    {
      "source": "/api/guest/increment",
      "destination": "/api/guest/increment.js"
    },
    {
      "source": "/api/guest/:slug",
      "destination": "/api/guest/[slug].js"
    },
    {
      "source": "/api/guests/bulk",
      "destination": "/api/guests/bulk.js"
    },
    {
      "source": "/api/guests/:id",
      "destination": "/api/guests.js"
    },
    {
      "source": "/api/guests",
      "destination": "/api/guests.js"
    },
    {
      "source": "/api/config",
      "destination": "/api/config.js"
    },
    {
      "source": "/api/sendMessage",
      "destination": "/api/sendMessage.js"
    },
    {
      "source": "/api/wishes",
      "destination": "/api/wishes.js"
    },
    {
      "source": "/api/test",
      "destination": "/api/test.js"
    },
    {
      "source": "/api/wishes-simple",
      "destination": "/api/wishes-simple.js"
    },
    {
      "source": "/api/status",
      "destination": "/api/status.js"
    },
    {
      "source": "/api/debug-wishes",
      "destination": "/api/debug-wishes.js"
    },
    {
      "source": "/api/test-storage",
      "destination": "/api/test-storage.js"
    },
    {
      "source": "/api/test-post-wish",
      "destination": "/api/test-post-wish.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
